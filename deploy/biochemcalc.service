# biochemcalc — 24/7 unattended operation on a headless VM, served as a
# real website (HTTP) instead of a Tauri GUI. No X server / WebKitGTK
# dependency at all anymore — the binary is a plain Axum HTTP server.
#
# Install as a per-user service (no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/biochemcalc.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now biochemcalc
#   loginctl enable-linger "$USER"   # keep it running after logout
#
# Deploy layout expected by ExecStart below — deliberately under the
# service user's own home, not /opt, so nothing here ever needs root:
#   ~/biochemcalc-web/biochemcalc-server   (release build of the server bin —
#                                            build ON the target machine's
#                                            architecture; the frontend's
#                                            static `dist/` is portable and
#                                            can be built anywhere and rsynced)
#   ~/biochemcalc-web/dist/                (output of `npm run build`)
#
# First run only: seeding the one teacher account that bootstraps invite-code
# issuance (nothing can invite the first account into existence). The two
# `BIOCHEMCALC_ADMIN_*` lines at the bottom are commented out deliberately —
# uncomment them, start the service once, then comment them out again and
# `systemctl --user daemon-reload && systemctl --user restart biochemcalc`.
#
# Delete them rather than leave them: a unit file is world-readable by
# default, so a password parked here is a plaintext credential sitting on
# disk long after the account it created has stopped needing it. Once any
# account exists the bootstrap is a no-op, so removing the lines costs
# nothing. If you truly need the credential to persist across rebuilds, put
# it in an `EnvironmentFile=%h/.config/biochemcalc.env` chmod 600 (or
# `systemd-creds encrypt`), never inline here.
#
# TODO: the session cookie is still not marked `Secure` (see
# src-tauri/src/http/middleware.rs). HTTPS now exists in front (nginx +
# Let's Encrypt for biocal.ubch.sci.muni.cz), so it can be turned on, but
# that would break sessions for anyone still reaching the app directly at
# http://147.251.22.180:8080, where credentials travel in cleartext.
# Close the direct-HTTP path first, then flip the cookie.
#
# Logs:
#   journalctl --user -u biochemcalc -f   # stdout/stderr incl. panics
#   ~/.local/share/com.kowalski.biochemcalc/logs/biochemcalc.log  # app log
# Data:
#   ~/.local/share/com.kowalski.biochemcalc/biochemcalc.sqlite
#   ~/.local/share/com.kowalski.biochemcalc/projekty/*.json
# Do NOT live-sync the app-data directory (Syncthing/Dropbox) while the app
# runs — syncing an open SQLite file is a corruption vector.
[Unit]
Description=BioCal (web server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/biochemcalc-web/biochemcalc-server
Restart=always
RestartSec=5
# Panics and hook-level diagnostics reach the journal via stderr.
Environment=RUST_BACKTRACE=1
Environment=BIOCHEMCALC_BIND_ADDR=0.0.0.0:8080
Environment=BIOCHEMCALC_DIST_DIR=%h/biochemcalc-web/dist
# Defaults to ~/.local/share/com.kowalski.biochemcalc if unset — the exact
# path the previous Tauri desktop build already used, so existing data is
# picked up unchanged. Uncomment to override:
# Environment=BIOCHEMCALC_DATA_DIR=/home/YOUR_USER/.local/share/com.kowalski.biochemcalc
# First-run only — uncomment, start once to seed the teacher account, then
# comment out again and reload. Left commented so a deployment can never
# acquire a plaintext password just by copying this file into place:
# Environment=BIOCHEMCALC_ADMIN_USERNAME=admin
# Environment=BIOCHEMCALC_ADMIN_PASSWORD=

# Password-reset emails via SMTP — optional. Omit all of these and the
# server still runs fine; it just logs the reset link instead of emailing
# it (see src-tauri/src/email.rs), which is enough for solo/dev use.
#
# Unlike the admin bootstrap above, this credential is meant to live here
# permanently — so, unlike that one, it does NOT go inline in this
# world-readable unit file. Non-secret settings are set directly below;
# BIOCHEMCALC_SMTP_USERNAME/_PASSWORD come from a separate file readable
# only by this user:
#   printf 'BIOCHEMCALC_SMTP_USERNAME=...\nBIOCHEMCALC_SMTP_PASSWORD=...\n' > ~/.config/biochemcalc-smtp.env
#   chmod 600 ~/.config/biochemcalc-smtp.env
# Sent via MUNI's central outgoing server (same for every faculty, incl.
# PřF) — smtp.muni.cz:587 STARTTLS, auth via <uco>@IS.MUNI.CZ + secondary
# password (not the primary UČO password). See
# https://it.muni.cz/sluzby/e-mailove-ucty-a-posta
Environment=BIOCHEMCALC_SMTP_HOST=smtp.muni.cz
Environment=BIOCHEMCALC_SMTP_PORT=587
Environment=BIOCHEMCALC_SMTP_FROM_ADDRESS=RejtarV@sci.muni.cz
Environment=BIOCHEMCALC_SMTP_FROM_NAME=BioCal
EnvironmentFile=-%h/.config/biochemcalc-smtp.env

# Externally-reachable origin used to build password-reset links; must be
# the HTTPS origin users actually see, because nginx (biocal.ubch.sci.muni.cz,
# Let's Encrypt) fronts the plain-HTTP app on :8080. The default
# (http://<BIND_ADDR>) is only correct for direct access with no reverse
# proxy in front.
Environment=BIOCHEMCALC_PUBLIC_URL=https://biocal.ubch.sci.muni.cz

[Install]
WantedBy=default.target
